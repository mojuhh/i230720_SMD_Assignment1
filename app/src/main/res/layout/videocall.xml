<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Remote Video Container (Full Screen) -->
    <FrameLayout
        android:id="@+id/remoteVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Local Video Container (Picture in Picture Overlay) -->
    <FrameLayout
        android:id="@+id/localVideoContainer"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:background="#222222"
        android:elevation="8dp" />

    <!-- Top Info Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#60000000"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aisha Khan"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Connecting..."
            android:textColor="#B0FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Controls Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#80000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Mute Audio Button -->
        <ImageView
            android:id="@+id/btnMute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#40FFFFFF"
            android:contentDescription="Mute Audio"
            android:padding="12dp"
            android:src="@drawable/mic" />

        <!-- Switch Camera Button -->
        <ImageView
            android:id="@+id/btnSwitchCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:background="#40FFFFFF"
            android:contentDescription="Switch Camera"
            android:padding="12dp"
            android:src="@drawable/flip_camera_android" />

        <!-- Mute Video Button -->
        <ImageView
            android:id="@+id/btnMuteVideo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:background="#40FFFFFF"
            android:contentDescription="Mute Video"
            android:padding="12dp"
            android:src="@drawable/photo_camera" />

        <!-- End Call Button -->
        <ImageView
            android:id="@+id/btnEndCall"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/avatar_circle"
            android:backgroundTint="#E53935"
            android:contentDescription="End Call"
            android:padding="14dp"
            android:src="@drawable/video_call" />

    </LinearLayout>

</FrameLayout>