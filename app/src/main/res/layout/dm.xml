<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;"
            android:textColor="#000000"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/avatar_circle"
            android:backgroundTint="@color/teal"
            android:gravity="center"
            android:text="AK"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReceiverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aisha Khan"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active now"
                android:textColor="#4CAF50"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnVoiceCall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Call"
                android:src="@drawable/video_call" />

            <ImageView
                android:id="@+id/btnVideoCall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="14dp"
                android:contentDescription="Video Call"
                android:src="@drawable/photo_camera" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="14dp"
                android:contentDescription="Info"
                android:src="@drawable/help" />
        </LinearLayout>
    </LinearLayout>

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Replying Preview Bar -->
    <LinearLayout
        android:id="@+id/layoutReplyPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F2F5"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReplyPreviewText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Replying to: "
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/btnCancelReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="✕"
            android:textColor="#888888"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Message Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnCameraMedia"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Camera"
                android:src="@drawable/photo_camera" />

            <ImageView
                android:id="@+id/btnGalleryMedia"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Gallery"
                android:src="@drawable/photo" />

            <ImageView
                android:id="@+id/btnSharePost"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Post"
                android:src="@drawable/share" />
        </LinearLayout>

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_card"
            android:hint="Type a message..."
            android:inputType="textCapSentences|textMultiLine"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#000000"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnSendMessage"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Send"
            android:padding="4dp"
            android:src="@drawable/send" />
    </LinearLayout>

</LinearLayout>