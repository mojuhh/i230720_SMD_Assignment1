<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Menu"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Settings" android:src="@drawable/settings" />
        <ImageView android:id="@+id/btnSearch" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="8dp" android:contentDescription="Search" android:src="@drawable/search" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnSeeProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_card"
        android:gravity="center_vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/avatar_circle"
            android:gravity="center"
            android:text="JW"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jacob West" android:textColor="#000000" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See your profile" android:textColor="#757575" android:textSize="11sp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&gt;" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="All shortcuts"
        android:textColor="#757575"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/rounded_card" android:gravity="center_vertical" android:paddingStart="8dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Memories" android:src="@drawable/memories" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Memories" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/rounded_card" android:gravity="center_vertical" android:paddingStart="8dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Saved" android:src="@drawable/saved" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Saved" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/rounded_card" android:gravity="center_vertical" android:paddingStart="8dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Groups" android:src="@drawable/social" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Groups" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/rounded_card" android:gravity="center_vertical" android:paddingStart="8dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Marketplace" android:src="@drawable/market" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Marketplace" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="8dp" android:gravity="center_vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Help" android:src="@drawable/help" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Help &amp; support" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Settings" android:src="@drawable/settings" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Settings &amp; privacy" android:textSize="12sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#E4E6EB"
        android:gravity="center"
        android:text="Log out"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>