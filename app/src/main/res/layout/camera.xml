<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/placeholder_img_dark">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/avatar_circle"
                android:backgroundTint="@color/gray"
                android:padding="10dp"
                android:src="@drawable/settings" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/avatar_circle"
                android:gravity="center"
                android:backgroundTint="@color/gray"
                android:text="✕"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#D1B89D" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:scaleType="center"
                android:scaleX="1.5"
                android:scaleY="1.5"
                android:layout_weight="1"
                android:src="@drawable/flash"
                android:gravity="center" />

            <FrameLayout
                android:id="@+id/btnShutter"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/avatar_circle"
                android:backgroundTint="#80FFFFFF">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/avatar_circle"
                    android:backgroundTint="#FFFFFF" />
            </FrameLayout>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:src="@drawable/flip_camera"
                android:scaleY="1.5"
                android:scaleX="1.5"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="6dp"
                android:src="@drawable/emoji" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="TEXT" android:textColor="#888888" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="LIVE" android:textColor="#888888" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="STORY" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="POST" android:textColor="#888888" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="BOOMERANG" android:textColor="#888888" android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>